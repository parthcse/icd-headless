# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated sitemap route manifest (rebuilt by the prebuild/predev script —
# see scripts/build-sitemap-manifest.mjs). Left untracked on purpose: it is
# regenerated on every build, and a tracked file that every build rewrites
# would block the "git pull" deploy on cPanel with local changes.
lib/sitemap-manifest.json
