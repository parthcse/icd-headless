<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stylesheet for the generated XML sitemaps (see lib/sitemap-sources.js).

  Replaces Yoast's main-sitemap.xsl, which used to be proxied off the CMS. It
  lives in /public so it is served from the SAME origin as the .xml files:
  browsers block cross-origin XSLT, so a stylesheet on cms.icecubedigital.com
  left the styled view blank. Everything is inline — no images, fonts or scripts
  to fetch — and XSLT 1.0 only, which is all browsers implement.

  Crawlers ignore this entirely; it only exists so a human opening a sitemap
  gets a readable table instead of raw markup.
-->
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:sm="http://www.sitemaps.org/schemas/sitemap/0.9">
  <xsl:output method="html" encoding="UTF-8" indent="yes"/>

  <xsl:template match="/">
    <html lang="en">
      <head>
        <title>XML Sitemap | Icecube Digital</title>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="robots" content="noindex, follow"/>
        <style>
          :root { color-scheme: light dark; }
          * { box-sizing: border-box; }
          body {
            margin: 0; padding: 32px 20px;
            font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: #1c1c1c; background: #f6f7f9;
          }
          .wrap { max-width: 1100px; margin: 0 auto; }
          h1 { margin: 0 0 6px; font-size: 24px; font-weight: 700; }
          h1 span { color: #F17E3F; }
          .meta { margin: 0 0 24px; color: #5c6470; font-size: 14px; }
          .meta code { background: #e9ecf1; padding: 2px 6px; border-radius: 4px; font-size: 13px; }
          table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
          th, td { text-align: left; padding: 11px 16px; border-bottom: 1px solid #eceef2; font-size: 14px; vertical-align: top; word-break: break-word; }
          th { background: #F17E3F; color: #fff; font-weight: 600; white-space: nowrap; }
          tr:last-child td { border-bottom: 0; }
          tr:nth-child(even) td { background: #fafbfc; }
          a { color: #c4571b; text-decoration: none; }
          a:hover { text-decoration: underline; }
          .num { width: 56px; color: #8b94a0; white-space: nowrap; }
          .date { width: 190px; white-space: nowrap; color: #5c6470; }
          @media (prefers-color-scheme: dark) {
            body { color: #e6e8ec; background: #15171a; }
            .meta { color: #9aa3ae; }
            .meta code { background: #24282e; }
            table { background: #1d2024; box-shadow: none; }
            th, td { border-color: #2a2f35; }
            tr:nth-child(even) td { background: #20242a; }
            a { color: #F6A16E; }
          }
        </style>
      </head>
      <body>
        <div class="wrap">
          <xsl:apply-templates/>
        </div>
      </body>
    </html>
  </xsl:template>

  <!-- Sitemap index: a list of the sub-sitemaps. -->
  <xsl:template match="sm:sitemapindex">
    <h1>XML Sitemap <span>Index</span></h1>
    <p class="meta">
      <xsl:value-of select="count(sm:sitemap)"/> sitemaps. Generated by the
      Icecube Digital frontend — see <code>lib/sitemap-sources.js</code>.
    </p>
    <table>
      <tr><th class="num">#</th><th>Sitemap</th><th class="date">Last modified</th></tr>
      <xsl:for-each select="sm:sitemap">
        <tr>
          <td class="num"><xsl:value-of select="position()"/></td>
          <td><a href="{sm:loc}"><xsl:value-of select="sm:loc"/></a></td>
          <td class="date"><xsl:call-template name="date"><xsl:with-param name="v" select="sm:lastmod"/></xsl:call-template></td>
        </tr>
      </xsl:for-each>
    </table>
  </xsl:template>

  <!-- A single sitemap: the URLs it contains. -->
  <xsl:template match="sm:urlset">
    <h1>XML <span>Sitemap</span></h1>
    <p class="meta">
      <xsl:value-of select="count(sm:url)"/> URLs, newest first. Generated by the
      Icecube Digital frontend — see <code>lib/sitemap-sources.js</code>.
    </p>
    <table>
      <tr><th class="num">#</th><th>URL</th><th class="date">Last modified</th></tr>
      <xsl:for-each select="sm:url">
        <tr>
          <td class="num"><xsl:value-of select="position()"/></td>
          <td><a href="{sm:loc}"><xsl:value-of select="sm:loc"/></a></td>
          <td class="date"><xsl:call-template name="date"><xsl:with-param name="v" select="sm:lastmod"/></xsl:call-template></td>
        </tr>
      </xsl:for-each>
    </table>
  </xsl:template>

  <!-- "2026-10-15T10:13:11+00:00" → "2026-10-15 10:13" (XSLT 1.0 has no date type). -->
  <xsl:template name="date">
    <xsl:param name="v"/>
    <xsl:choose>
      <xsl:when test="string-length($v) &gt; 15">
        <xsl:value-of select="concat(substring($v, 1, 10), ' ', substring($v, 12, 5))"/>
      </xsl:when>
      <xsl:otherwise><xsl:value-of select="$v"/></xsl:otherwise>
    </xsl:choose>
  </xsl:template>
</xsl:stylesheet>
